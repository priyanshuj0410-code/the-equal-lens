{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://theequallens.com/schema/job.schema.json",
  "title": "Job",
  "type": "object",
  "required": ["id", "title", "type", "summary", "status"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "title": { "type": "string" },
    "type": { "type": "string", "enum": ["full-time", "part-time", "contract", "volunteer", "internship"] },
    "location": { "type": "string" },
    "remote": { "type": "boolean" },
    "summary": { "type": "string" },
    "responsibilities": { "type": "array", "items": { "type": "string" } },
    "requirements": { "type": "array", "items": { "type": "string" } },
    "compensation": { "type": "string" },
    "applyEmail": { "type": "string" },
    "postedDate": { "type": "string", "format": "date" },
    "status": { "type": "string", "enum": ["open", "closed"] },
    "placeholder": { "type": "boolean" }
  }
}
