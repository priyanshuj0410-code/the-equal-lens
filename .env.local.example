# Sanity CMS — fill these in after creating a free project at https://www.sanity.io
# Copy this file to .env.local for local dev, and add the same vars in Vercel
# (Project → Settings → Environment Variables).

# Public (safe to expose to the browser):
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Secret (server-only) — shared with the Sanity "publish" webhook so the live
# site can revalidate instantly. Use any long random string; set the same value
# as the webhook secret in Sanity.
SANITY_REVALIDATE_SECRET=

# Secret (server-only) — Sanity token with create permission, used to store
# visitor submissions (Lensy answers, facilitator applications). Leave empty
# to disable writes (features no-op instead of erroring).
SANITY_WRITE_TOKEN=

# Transactional email (Resend). Sends the confirmation + team notification on
# facilitator signups. Leave RESEND_API_KEY empty to disable sending — signups
# still work, they just skip the emails. EMAIL_FROM must use a domain verified
# in Resend (until then Resend only delivers from onboarding@resend.dev).
RESEND_API_KEY=
EMAIL_FROM=The Equal Lens <hello@theequallens.com>
FACILITATOR_NOTIFY_EMAIL=rashi.khandelwal@theequallens.com
